  "body": [
    { "text": "無上甚深微妙法", "ruby": "むじょうじんじんみみょうほう" },
    { "text": "百千万劫難遭遇", "ruby": "ひゃくせんまんごうなんそうぐう" },
    { "text": "我今見聞得受持", "ruby": "がこんけんもんとくじゅじ" },
    { "text": "願解如来真実義", "ruby": "がんげにょらいしんじつぎ" }
