  "title": "餓鬼回向文",
  "reading": "がきえこーもん",
  "body": [
    { "text": "願籍斯善", "ruby": "がんしゃくしぜん" },
    { "text": "一切餓鬼", "ruby": "いっさいがき" },
    { "text": "罪障消滅", "ruby": "ざいしょーしょーめつ" },
    { "text": "離苦得樂", "ruby": "りくとくらく" },
    { "text": "發心修行", "ruby": "ほっしんしゅぎょー" },
    { "text": "臨終見佛", "ruby": "りんじゅーけんぶつ" },
    { "text": "超生淨土", "ruby": "ちょーしょーじょーど" },
    { "text": "究竟成佛", "ruby": "くきょーじょーぶつ" }
  ],
  "source": {
