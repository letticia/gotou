{
  "id": "daiku-shinjin-ganmon",
  "title": "誦経(仏説観無量寿経 第九真身観文)",
  "reading": "じゅきょう(ぶっせつかんむりょうじゅきょう だいくしんじんがんもん)",
  "paginated": true,
  "body": [
    {
      "text": "仏告阿難",
      "ruby": "ぶつごうあーなん"
    },
    {
      "text": "及韋提希",
      "ruby": "ぎゅういーだいけー"
    },
    {
      "text": "此想成已",
      "ruby": "しーそうじょういー"
    },
    {
      "text": "次当更観",
      "ruby": "しーとうきょうかん"
    },
    {
      "text": "無量寿仏",
      "ruby": "むーりょうじゅーぶつ"
    },
    {
      "text": "身相光明",
      "ruby": "しんそうこうみょう"
    },
    {
      "text": "阿難当知",
      "ruby": "あーなんとうちー"
    },
    {
      "text": "無量寿仏身",
      "ruby": "むーりょうじゅーぶっしん"
    },
    {
      "text": "如百千万億",
      "ruby": "にょーひゃくせんまんのく"
    },
    {
      "text": "夜摩天",
      "ruby": "やーまーてん"
    },
    {
      "text": "閻浮檀金色",
      "ruby": "えんぶーだんごんじき"
    },
    {
      "text": "仏身高",
      "ruby": "ぶっしんこう"
    },
    {
      "text": "六十万億",
      "ruby": "ろくじゅうまんのく"
    },
    {
      "text": "那由他",
      "ruby": "なーゆーたー"
    },
    {
      "text": "恒河沙由旬",
      "ruby": "ぶごうがーしゃーゆーじゅん"
    },
    {
      "text": "眉間白毫",
      "ruby": "みーけんびゃくごう"
    },
    {
      "text": "右旋婉転",
      "ruby": "うーせんおんでん"
    },
    {
      "text": "如五須弥山",
      "ruby": "にょーごーしゅーみーせん"
    },
    {
      "text": "仏眼",
      "ruby": "ぶつげん"
    },
    {
      "text": "如四大海水",
      "ruby": "にょーしーだいかいすい"
    },
    {
      "text": "青白分明",
      "ruby": "しょうびゃくふんみょう"
    },
    {
      "text": "身諸毛孔",
      "ruby": "しんしょーもうくー"
    },
    {
      "text": "演出光明",
      "ruby": "えんじゅつこうみょう"
    },
    {
      "text": "如須弥山",
      "ruby": "にょーしゅーみーせん"
    },
    {
      "text": "彼仏円光",
      "ruby": "ひーぶつえんこう"
    },
    {
      "text": "如百億三千",
      "ruby": "にょーひゃくおくさんぜん"
    },
    {
      "text": "大千世界",
      "ruby": "だいせんせーかい"
    },
    {
      "text": "於円光中",
      "ruby": "おーえんこうじゅう"
    },
    {
      "text": "有百万億",
      "ruby": "うーひゃくまんのく"
    },
    {
      "text": "那由佗",
      "ruby": "なーゆーたー"
    },
    {
      "text": "恒河沙化仏",
      "ruby": "ごうがーしゃーけーぶつ"
    },
    {
      "text": "一一化仏",
      "ruby": "いちいちけーぶつ"
    },
    {
      "text": "亦有衆多",
      "ruby": "やくうーしゅうたー"
    },
    {
      "text": "無数化菩薩",
      "ruby": "むーしゅうけーぼーさつ"
    },
    {
      "text": "以為侍者",
      "ruby": "いーいーじーしゃー"
    },
    {
      "text": "無量寿仏",
      "ruby": "むーりょうじゅーぶつ"
    },
    {
      "text": "有八万四千相",
      "ruby": "うーはちまんしーせんそう"
    },
    {
      "text": "一一相",
      "ruby": "いちいちそう"
    },
    {
      "text": "各有八万四千",
      "ruby": "かくうーはちまんしーせん"
    },
    {
      "text": "随形好",
      "ruby": "ずいぎょうこう"
    },
    {
      "text": "一一好",
      "ruby": "いちいちこう"
    },
    {
      "text": "復有八万四千光明",
      "ruby": "ぶーうーはちまんしーせんこうみょう"
    },
    {
      "text": "一一光明徧照",
      "ruby": "いちいちこうみょうへんじょう"
    },
    {
      "text": "十方世界",
      "ruby": "じっぽうせーかい"
    },
    {
      "text": "念仏衆生",
      "ruby": "ねんぶっしゅーじょう"
    },
    {
      "text": "摂取不捨",
      "ruby": "せっしゅーふーしゃー"
    },
    {
      "text": "其光明相好",
      "ruby": "ごーこうみょうそうごう"
    },
    {
      "text": "及与化仏",
      "ruby": "ぎゅうよーけーぶつ"
    },
    {
      "text": "不可具説",
      "ruby": "ふーかーぐーせつ"
    },
    {
      "text": "但当憶想",
      "ruby": "たんとうおくそう"
    },
    {
      "text": "令心眼見",
      "ruby": "りょうしんげんけん"
    },
    {
      "text": "見此事者",
      "ruby": "けんしーじーしゃー"
    },
    {
      "text": "即見十方",
      "ruby": "そっけんじっぽう"
    },
    {
      "text": "一切諸仏",
      "ruby": "いっさいしょーぶつ"
    },
    {
      "text": "以見諸仏故",
      "ruby": "いーけんしょーぶっこー"
    },
    {
      "text": "名念仏三昧",
      "ruby": "みょうねんぶっさんまい"
    },
    {
      "text": "作是観者",
      "ruby": "さーぜーかんしゃー"
    },
    {
      "text": "名観一切仏身",
      "ruby": "みょうかんいっさいぶっしん"
    },
    {
      "text": "以観仏身故",
      "ruby": "いーかんぶっしんこー"
    },
    {
      "text": "亦見仏心",
      "ruby": "やっけんぶっしん"
    },
    {
      "text": "仏心者",
      "ruby": "ぶっしんしゃー"
    },
    {
      "text": "大慈悲是",
      "ruby": "だいじーひーぜー"
    },
    {
      "text": "以無縁慈",
      "ruby": "いーむーえんじー"
    },
    {
      "text": "摂諸衆生",
      "ruby": "せっしょーしゅーじょう"
    },
    {
      "text": "作此観者",
      "ruby": "さーしーかんしゃー"
    },
    {
      "text": "捨身他世",
      "ruby": "しゃーしんたーせー"
    },
    {
      "text": "生諸仏前",
      "ruby": "しょうしょーぶつぜん"
    },
    {
      "text": "得無生忍",
      "ruby": "とくむーしょうにん"
    },
    {
      "text": "是故智者",
      "ruby": "ぜーこーちーしゃー"
    },
    {
      "text": "応当繋心",
      "ruby": "おうとうけいしん"
    },
    {
      "text": "諦観無量寿仏",
      "ruby": "たいかんむーりょうじゅーぶつ"
    },
    {
      "text": "観無量寿仏者",
      "ruby": "かんむーりょうじゅーぶっしゃー"
    },
    {
      "text": "従一相好入",
      "ruby": "じゅーいちそうごうにゅう"
    },
    {
      "text": "但観眉間白毫",
      "ruby": "たんかんみーけんびゃくごう"
    },
    {
      "text": "極令明了",
      "ruby": "ごくりょうみょうりょう"
    },
    {
      "text": "見眉間白毫者",
      "ruby": "けんみーけんびゃくごうしゃー"
    },
    {
      "text": "八万四千相好",
      "ruby": "はちまんしーせんそうごう"
    },
    {
      "text": "自然当現",
      "ruby": "じーねんとうげん"
    },
    {
      "text": "見無量寿仏者",
      "ruby": "けんむーりょうじゅーぶっしゃー"
    },
    {
      "text": "即見十方",
      "ruby": "そっけんじっぽう"
    },
    {
      "text": "無量諸仏",
      "ruby": "むーりょうしょーぶつ"
    },
    {
      "text": "得見無量諸仏故",
      "ruby": "とっけんむーりょうしょーぶっこー"
    },
    {
      "text": "諸仏現前授記",
      "ruby": "しょーぶつげんぜんじゅーきー"
    },
    {
      "text": "是為徧観",
      "ruby": "ぜーいーへんかん"
    },
    {
      "text": "一切色身想",
      "ruby": "いっさいしきしんそう"
    },
    {
      "text": "名第九観",
      "ruby": "みょうだいくーかん"
    },
    {
      "text": "作此観者",
      "ruby": "さーしーかんしゃー"
    },
    {
      "text": "名為正観",
      "ruby": "みょういーしょうがん"
    },
    {
      "text": "若他観者",
      "ruby": "にゃくたーかんしゃー"
    },
    {
      "text": "名為邪観",
      "ruby": "みょういーじゃーかん"
    }
  ],
