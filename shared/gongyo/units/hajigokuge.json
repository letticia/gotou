  "id": "hajigokuge",
  "title": "破地獄偈",
  "reading": "はじごくげ",
  "body": [
    { "text": "若人欲了知", "ruby": "にゃくにんよくりょーち" },
    { "text": "三世一切佛", "ruby": "さんぜーいっさいぶー" },
    { "text": "應觀法界性", "ruby": "おーかんほーかいしょー" },
    { "text": "一切唯心造", "ruby": "いっさいゆいしんぞー" }
  ],
